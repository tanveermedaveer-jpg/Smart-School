{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": [
        "server/readDb.js",
        "server/writeDb.js",
        "server/data/db.json"
      ]
    }
  }
}
